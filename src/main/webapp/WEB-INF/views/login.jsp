<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sign in · SmartClass 3D</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/app.css"></head>
<body class="login-page"><main class="login-shell">
<section class="login-visual"><div class="brand-mark">SC</div><p class="eyebrow">LIVE CAMPUS INTELLIGENCE</p><h1>Find an empty classroom before your next idea arrives.</h1><p class="lead">One view for live room status, weekly timetables, bookings and campus operations.</p><div class="mini-campus" aria-hidden="true"><i></i><i></i><i></i><i></i><span></span></div><div class="status-strip"><span><b class="dot available"></b>Available</span><span><b class="dot occupied"></b>Occupied</span><span><b class="dot reserved"></b>Reserved</span></div></section>
<section class="login-card"><p class="eyebrow">SMARTCLASS 3D</p><h2>Welcome back</h2><p>Choose your role and enter your campus account.</p>
<c:if test="${not empty error}"><div class="alert error"><c:out value="${error}"/></div></c:if><c:if test="${param.expired eq '1'}"><div class="alert error">Your previous login form expired after the application restarted. The form is refreshed—please sign in again.</div></c:if><c:if test="${param.logout eq '1'}"><div class="alert success">You have been signed out safely.</div></c:if>
<form method="post" action="${pageContext.request.contextPath}/login" class="stack"><input type="hidden" name="_csrf" value="${sessionScope.csrfToken}"><label>Role<select name="role" required><option value="STUDENT">Student</option><option value="LECTURER">Lecturer</option><option value="ADMIN">Administrator</option></select></label><label>Email<input type="email" name="email" autocomplete="username" placeholder="student@smartclass.com" required></label><label>Password<input type="password" name="password" autocomplete="current-password" required></label><button class="primary wide" type="submit">Enter campus dashboard <span>→</span></button></form>
<details class="demo"><summary>Demo accounts</summary><p>Student: student@smartclass.com / Student@123</p><p>Lecturer: lecturer@smartclass.com / Lecturer@123</p><p>Admin: admin@smartclass.com / Admin@123</p></details></section>
</main></body></html>
