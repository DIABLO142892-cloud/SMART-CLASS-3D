<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Campus Dashboard · SmartClass 3D</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/app.css?v=20260908-1"><style>.form-error{padding:11px 13px;border:1px solid #f0b4ad;border-radius:10px;background:#fff0ed;color:#9b2f23;font-size:13px;font-weight:650}</style></head>
<body data-context="${pageContext.request.contextPath}" data-role="${user.role}"><div class="app-shell">
<aside class="sidebar"><a class="logo" href="#overview"><span>SC</span><strong>SmartClass<small>3D CAMPUS</small></strong></a><nav><button class="nav active" data-view="overview">Overview</button><button class="nav" data-view="finder">Classroom finder</button><button class="nav" data-view="bookings">Bookings</button><button class="nav" data-view="timetable">Timetable</button><button class="nav admin-only" data-view="admin">Administration</button></nav><div class="sidebar-foot"><span class="avatar"><c:out value="${fn:substring(user.fullName,0,1)}"/></span><div><b><c:out value="${user.fullName}"/></b><small><c:out value="${user.role}"/></small></div></div></aside>
<main class="main"><header class="topbar"><div><p class="eyebrow">CAMPUS OPERATIONS</p><h1 id="page-title">Live overview</h1></div><div class="top-actions"><span id="sync-state" class="sync">Connecting…</span><form method="post" action="${pageContext.request.contextPath}/logout"><input type="hidden" name="_csrf" value="${sessionScope.csrfToken}"><button class="ghost">Sign out</button></form></div></header><div id="notice" class="notice" role="status" hidden></div>
<section id="view-overview" class="view active"><div class="hero"><div><p class="eyebrow">RIGHT NOW</p><h2>Good day, <c:out value="${user.fullName}"/>.</h2><p>See where the campus has space, then act in a few clicks.</p></div><div class="clock"><b id="clock">--:--</b><span id="date">Loading campus time</span></div></div><div id="stats" class="stats skeleton"></div><div class="overview-grid"><section class="panel campus-panel"><div class="panel-head"><div><p class="eyebrow">INTERACTIVE MAP</p><h3>3D campus pulse</h3></div><div class="legend"><span><i class="dot available"></i>Available</span><span><i class="dot occupied"></i>Occupied</span><span><i class="dot reserved"></i>Reserved</span><span><i class="dot maintenance"></i>Maintenance</span></div></div><canvas id="campus-canvas" aria-label="Interactive 3D campus view"></canvas><p class="canvas-help">Drag to rotate · scroll to zoom · select a building to filter rooms</p></section><section class="panel"><div class="panel-head"><div><p class="eyebrow">AVAILABLE NOW</p><h3>Best options</h3></div><button class="text-button" data-jump="finder">View all →</button></div><div id="quick-rooms" class="room-list"></div></section></div></section>
<section id="view-finder" class="view"><div class="section-head"><div><p class="eyebrow">DISCOVER SPACE</p><h2>Classroom finder</h2></div></div><div class="filters"><input id="search" type="search" placeholder="Search room, building or facility"><select id="building-filter"><option value="">All buildings</option></select><select id="status-filter"><option value="">All statuses</option><option>AVAILABLE</option><option>OCCUPIED</option><option>RESERVED</option><option>MAINTENANCE</option></select><input id="capacity-filter" type="number" min="0" placeholder="Min. seats"></div><div id="room-grid" class="room-grid"></div></section>
<section id="view-bookings" class="view"><div class="section-head"><div><p class="eyebrow">RESERVATIONS</p><h2>Bookings</h2></div><button id="new-booking" class="primary">New request</button></div><div id="booking-table" class="table-wrap"></div></section>
<section id="view-timetable" class="view"><div class="section-head"><div><p class="eyebrow">WEEKLY PLAN</p><h2>Timetable</h2></div></div><div id="timetable" class="schedule"></div></section>
<section id="view-admin" class="view admin-only"><div class="section-head"><div><p class="eyebrow">CONTROL CENTRE</p><h2>Administration</h2></div></div><div class="admin-tabs"><button class="chip active" data-admin="rooms">Rooms</button><button class="chip" data-admin="buildings">Buildings</button><button class="chip" data-admin="timetable">Timetable</button><button class="chip" data-admin="users">Users</button><button class="chip" data-admin="auditLogs">Audit log</button></div><div id="admin-panel" class="table-wrap"></div></section>
</main></div><dialog id="modal"><div class="modal-card"><header><div><p class="eyebrow" id="modal-kicker">SMARTCLASS</p><h2 id="modal-title">Details</h2></div><button type="button" class="icon-button" data-close aria-label="Close">×</button></header><div id="modal-body"></div></div></dialog>
<script type="module" src="${pageContext.request.contextPath}/js/app.js?v=20260908-1"></script></body></html>
